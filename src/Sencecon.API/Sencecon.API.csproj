<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Sencecon.API</RootNamespace>
    <UserSecretsId>e6f2f7a0-2b8b-4b2a-9c2d-sencecon-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <!-- Required by `dotnet ef` when this project is the EF Core startup project (design-time tooling). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Pinned to 9.x: Swashbuckle 10+ moved to Microsoft.OpenApi v2, which restructured the
         Microsoft.OpenApi.Models types used below (OpenApiInfo, OpenApiSecurityScheme, etc.). -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sencecon.Application\Sencecon.Application.csproj" />
    <ProjectReference Include="..\Sencecon.Infrastructure\Sencecon.Infrastructure.csproj" />
  </ItemGroup>

</Project>
